    <width>780</width>
    <height>320</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Generation options</string>
  </property>
  <layout class="QHBoxLayout" name="horizontalLayoutMain">
   <item>
    <layout class="QVBoxLayout" name="verticalLayout">
     <item>
      <widget class="QGroupBox" name="groupInputImage">
       <property name="title">
        <string>Input image</string>
       </property>
       <layout class="QVBoxLayout" name="verticalLayoutImage">
        <item>
         <widget class="QRadioButton" name="radioKeep">
          <property name="text">
           <string>Keep the input image as it is</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QRadioButton" name="radioReusePrevious">
          <property name="text">
           <string>Reuse the previously regenerated image (see preview on the right)</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QRadioButton" name="radioRegenerate">
          <property name="text">
           <string>Regenerate the input (remove social icons / text, improve quality)</string>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="horizontalLayoutWhiteBackground">
          <item>
           <spacer name="horizontalSpacerWhiteBackground">
            <property name="orientation">
             <enum>Qt::Orientation::Horizontal</enum>
            </property>
            <property name="sizeType">
             <enum>QSizePolicy::Policy::Fixed</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>20</width>
              <height>1</height>
             </size>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QCheckBox" name="checkBoxWhiteBackground">
            <property name="text">
             <string>Isolate the product only, on a plain white background (no model/human)</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <layout class="QHBoxLayout" name="horizontalLayoutApplyBoth">
          <item>
           <spacer name="horizontalSpacerApplyBoth">
            <property name="orientation">
             <enum>Qt::Orientation::Horizontal</enum>
            </property>
            <property name="sizeType">
             <enum>QSizePolicy::Policy::Fixed</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>20</width>
              <height>1</height>
             </size>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QCheckBox" name="checkBoxApplyBoth">
            <property name="text">
             <string>Apply this on 2 images</string>
            </property>
            <property name="toolTip">
             <string>Apply the regeneration step to both input images</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QRadioButton" name="radioBootstrap">
          <property name="text">
           <string>Bootstrap a new image (close but different image will be generated)</string>
